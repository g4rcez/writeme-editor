{
    "name": "writeme",
    "version": "1.0.12",
    "private": true,
    "description": "Writeme is an Electron and PWA note-taking app with a rich Markdown editor powered by Tiptap. Features syntax highlighting via Shiki, Mermaid and Graphviz diagrams, Excalidraw drawing, math rendering with KaTeX and mathjs, AI chat integration, SQLite and IndexedDB dual storage, and full keyboard-driven navigation.",
    "keywords": [
        "ai",
        "diagrams",
        "editor",
        "electron",
        "excalidraw",
        "katex",
        "markdown",
        "math",
        "mermaid",
        "note-taking",
        "notes",
        "offline",
        "prosemirror",
        "pwa",
        "rich-text-editor",
        "shiki",
        "sqlite",
        "syntax-highlighting",
        "text-editor",
        "tiptap"
    ],
    "license": "MIT",
    "author": {
        "name": "g4rcez",
        "url": "https://github.com/g4rcez/writeme-editor"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/g4rcez/writeme-editor"
    },
    "bin": {
        "writeme": "./packages/cli/dist/writeme"
    },
    "main": ".vite/build/main.js",
    "scripts": {
        "dev": "npm run native:dev",
        "browser:dev": "concurrently -k \"tsx src/server/start.ts\" \"vite --host\"",
        "proxy": "tsx src/server/start.ts",
        "browser:build": "vite build",
        "build": "npm run make",
        "native:dev": "electron-forge start",
        "build:cli": "npm --prefix packages/cli run build",
        "build:package": "npm run make",
        "package:app": "npm run build:cli && electron-forge package",
        "make": "npm run build:cli && electron-forge make",
        "publish": "npm run build:cli && electron-forge publish",
        "postinstall": "electron-rebuild",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "lint:fix": "oxlint --fix",
        "lint": "oxlint",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "pwa:assets": "node scripts/generate-pwa-assets.js",
        "pwa:dev": "npm run pwa:assets && npm run browser:dev",
        "pwa:build": "npm run pwa:assets && npm run browser:build",
        "ci:local": "act push -W .github/workflows/build.yml --matrix os:ubuntu-latest",
        "release": "bash scripts/release.sh"
    },
