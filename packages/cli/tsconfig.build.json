{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "sourceMap": true,
        "rewriteRelativeImportExtensions": true,
        "paths": {}
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/tests"
    ]
}
