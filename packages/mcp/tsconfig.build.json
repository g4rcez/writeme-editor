{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "declaration": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "types": ["node", "bun"]
    },
    "include": ["src"],
    "exclude": ["tests", "scripts", "e2e"]
}
