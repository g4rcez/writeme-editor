{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "lib": ["ESNext", "DOM"]
    },
    "include": ["src", "tests", "scripts"]
}
